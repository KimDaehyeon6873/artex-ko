# syntax=docker/dockerfile:1
# 로컬 VM용: 프런트엔드와 Go 바이너리를 모두 소스에서 빌드한다.
FROM node:22-bookworm-slim AS web
WORKDIR /src/web
ENV NEXT_TELEMETRY_DISABLED=1 HUSKY=0
COPY web/package.json web/package-lock.json ./
RUN npm ci --include=dev
COPY web/ ./
RUN npm run build:static

FROM golang:1.26-bookworm AS backend
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /src/web/out/ ./server/webui/dist/
RUN CGO_ENABLED=0 go build -tags embedui -trimpath \
    -ldflags "-s -w -X main.version=local-vm" -o /out/artex ./cmd/artex

FROM python:3.12-slim-bookworm AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget git jq ripgrep unzip \
      dnsutils iputils-ping netcat-openbsd whois nmap \
    && rm -rf /var/lib/apt/lists/*
# 동일한 Debian 계열의 Node 런타임. VM 호스트에는 Node/Go가 필요 없다.
COPY --from=web /usr/local/bin/node /usr/local/bin/node
COPY --from=web /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && groupadd --gid 10001 artex \
    && useradd --uid 10001 --gid artex --create-home artex
WORKDIR /app
COPY --from=backend /out/artex ./artex
COPY start.sh ./start.sh
COPY --chown=10001:10001 skills/ ./skills/
# JWT 키는 파일 탐색기가 노출하는 /app/data 밖의 별도 볼륨에 보존한다.
RUN mkdir -p /app/data /var/lib/artex-private \
    && chown artex:artex /app/data /var/lib/artex-private \
    && ln -s /var/lib/artex-private/jwt.key /app/jwt.key \
    && chmod 755 /app/artex /app/start.sh
ENV HOME=/home/artex PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
EXPOSE 8787 8788
ENTRYPOINT ["/app/start.sh"]
CMD ["-addr", ":8787", "-proxy", ":8788", "-data", "/app/data"]
